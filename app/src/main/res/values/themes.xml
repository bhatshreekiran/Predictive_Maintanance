<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Cogxar" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Single Brand Accent Color (Industrial Amber) -->
        <item name="colorPrimary">@color/accent_brand</item>
        <item name="colorOnPrimary">@color/bg_base</item>
        <item name="colorPrimaryContainer">@color/bg_card</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary color (monochromatic industrial tone) -->
        <item name="colorSecondary">@color/accent_brand</item>
        <item name="colorOnSecondary">@color/bg_base</item>

        <!-- Background & Flat Surface -->
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_input</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status & Navigation Bars: Flat, seamless graphite -->
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- CardView style: Flat surface, 1dp border, 8dp corners, 0dp elevation (no shadows) -->
        <item name="materialCardViewStyle">@style/Widget.Cogxar.Card</item>
    </style>

    <style name="Widget.Cogxar.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/border_card</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Cogxar.Card.Alert" parent="Widget.Cogxar.Card">
        <item name="strokeColor">@color/status_red</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>
</resources>
